FINAL_LIBRARY = "mozglue"

EXPORTS.mozilla += [
    "AwakeTimeStamp.h",
    "decimal/Decimal.h",
    "decimal/DoubleConversion.h",
    "Futex.h",
    "IntegerPrintfMacros.h",
    "LoggingCore.h",
    "LSX.h",
    "MmapFaultHandler.h",
    "Now.h",
    "PerfStats.h",
    "PlatformConditionVariable.h",
    "PlatformMutex.h",
    "PlatformRWLock.h",
    "Printf.h",
    "RoundedMulDiv.h",
    "SIMD.h",
    "Sprintf.h",
    "SSE.h",
    "StackWalk.h",
    "TimeStamp.h",
    "Uptime.h",
]

EXPORTS.mozilla.glue += [
    "Debug.h",
]


SOURCES += [
    "AwakeTimeStamp.cpp",
    "Debug.cpp",
    "LoggingCore.cpp",
    "MmapFaultHandler.cpp",
    "PerfStats.cpp",
    "Printf.cpp",
    "SIMD.cpp",
    "StackWalk.cpp",
]

if CONFIG["TARGET_CPU"].startswith("x86"):
    SOURCES += [
        "SIMD_avx2.cpp",
        "SSE.cpp",
    ]
    SOURCES["SIMD_avx2.cpp"].flags += ["-mavx2"]

if CONFIG["TARGET_CPU"] == "loongarch64":
    SOURCES += [
        "LSX.cpp",
        "SIMD_lsx.cpp",
    ]
    SOURCES["SIMD_lsx.cpp"].flags += CONFIG["LSX_FLAGS"]

if not CONFIG["JS_STANDALONE"]:
    EXPORTS.mozilla += [
        "ProcessType.h",
        "RuntimeExceptionModule.h",
    ]

    SOURCES += [
        "ProcessType.cpp",
        "RuntimeExceptionModule.cpp",
    ]

OS_LIBS += CONFIG["REALTIME_LIBS"]


SOURCES += [
    "ConditionVariable_posix.cpp",
    "Mutex_posix.cpp",
    "RWLock_posix.cpp",
]


SOURCES += [
    "decimal/Decimal.cpp",
]

# Suppress warnings from third-party V8 Decimal code.
SOURCES["decimal/Decimal.cpp"].flags += ["-Wno-implicit-fallthrough"]

for var in ("MOZ_APP_BASENAME", "MOZ_APP_VENDOR"):
    DEFINES[var] = '"%s"' % CONFIG[var]

include("/mozglue/misc/timestamp.mozbuild")
