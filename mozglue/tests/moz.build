# to testing/cppunittest.ini.

GeckoCppUnitTests(
    [
        "ShowSSEConfig",
    ],
    linkage=None,
)

CppUnitTests([
    "TestBaseProfiler",
    "TestIntegerPrintfMacros",
    "TestPrintf",
])

with Files("TestBaseProfiler.cpp"):
    BUG_COMPONENT = ("Core", "Gecko Profiler")



TEST_DIRS += [
    "gtest",
]
