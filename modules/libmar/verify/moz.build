Library("verifymar")

UNIFIED_SOURCES += [
    "cryptox.c",
    "mar_verify.c",
]

FORCE_STATIC_LIB = True

if CONFIG["OS_ARCH"] == "Darwin" and not CONFIG["MOZ_USE_NSS_FOR_MAR"]:
    UNIFIED_SOURCES += [
        "MacVerifyCrypto.cpp",
    ]
    OS_LIBS += [
        "-framework Security",
    ]
else:
    USE_LIBS += [
        "nspr",
        "nss",
        "signmar",
    ]

LOCAL_INCLUDES += [
    "../src",
]

if CONFIG["MOZ_USE_NSS_FOR_MAR"]:
    LOCAL_INCLUDES += ["../sign"]
    DEFINES["MAR_NSS"] = True

SOURCE_HEADERS += [
    "cryptox.h",
]
