# dmgInstallHelper
# ==============================================================

option(
    "--enable-dmg-install-helper-debug",
    when=target_is_osx,
    help="Enable the DMG Install Helper for debugging",
)


@depends("--enable-dmg-install-helper-debug", when=target_is_osx)
def debug_dmg_install_helper(enabled):
    if enabled:
        return True


set_config("DMG_INSTALL_HELPER_DEBUG", debug_dmg_install_helper)


# Mac privileged helper without production signing
# ==============================================================

option(
    "--enable-mac-elevated-updates-with-generic-certs",
    when=target_is_osx,
    help="Allow local developer-signed builds to use the privileged DMG install helper on macOS",
)


def mac_prod_requirements_string(identifier):
    return (
        f'identifier "{identifier}" and anchor apple generic and '
        "certificate 1[field.1.2.840.113635.100.6.2.6] and "
        "certificate leaf[field.1.2.840.113635.100.6.1.13] and "
        'certificate leaf[subject.OU] = "43AQ936H96"'
    )


def mac_relaxed_requirements_string(identifier):
    return f'identifier "{identifier}" and anchor apple generic'


@depends(
    "--enable-mac-elevated-updates-with-generic-certs",
    moz_mac_bundle_id,
    when=target_is_osx,
)
def smauthorizedclients_requirements(enabled, bundle_id):
    if enabled:
        return mac_relaxed_requirements_string(bundle_id)
    else:
        return mac_prod_requirements_string(bundle_id)


set_config("MOZ_SMAUTHORIZEDCLIENTS_REQUIREMENTS", smauthorizedclients_requirements)


def requirements_string(exec_id, relaxed):
    if relaxed:
        return mac_relaxed_requirements_string(exec_id)
    else:
        return mac_prod_requirements_string(exec_id)


@depends("--enable-mac-elevated-updates-with-generic-certs", when=target_is_osx)
@imports(_from="xml.sax.saxutils", _import="escape")
def generate_smprivilegedexec_requirements(relaxed):
    requirements = ""
    smprivilegedexecutables_list = [
        "org.mozilla.dmgInstallHelper",
    ]

    for executable in smprivilegedexecutables_list:
        requirements += f"<key>{escape(executable)}</key>"
        requirements += (
            f"<string>{escape(requirements_string(executable, relaxed))}</string>"
        )

    return requirements


set_config(
    "MOZ_SMPRIVILEGEDEXECUTABLES_REQUIREMENTS", generate_smprivilegedexec_requirements
)

# Enable or disable the default browser agent, which monitors the user's default
# browser setting on Windows.
# ==============================================================================


@depends(target, build_project)
def default_browser_agent_default(target, build_project):
    return target.os == "WINNT" and build_project == "browser"


option(
    "--enable-default-browser-agent",
    default=default_browser_agent_default,
    help="{Enable|Disable} building the default browser agent",
)


@depends("--enable-default-browser-agent", when=target_is_windows)
def default_agent_flag(enabled):
    if enabled:
        return True


set_config("MOZ_DEFAULT_BROWSER_AGENT", default_agent_flag)


# Enable or disable the notification server, which allows Windows native
# notifications to persist when the application is not running and relaunch as
# necessary.
# ==============================================================================
@depends(target, build_project)
def notification_server_default(target, build_project):
    return target.os == "WINNT" and build_project in (
        "browser",
        "comm/mail",
    )


option(
    "--disable-notification-server",
    when=notification_server_default,
    help="Disable building the notification server",
)


@depends("--enable-notification-server", when=notification_server_default)
def notification_server_flag(enabled):
    if enabled:
        return True


set_config("MOZ_NOTIFICATION_SERVER", notification_server_flag)


# Enable or disable the push notification helper, which allows web push
# notifications to be delivered when Firefox is closed.
# ==============================================================================
@depends(target, build_project)
def push_notification_helper_default(target, build_project):
    return target.os == "WINNT" and build_project == "browser"


option(
    "--disable-push-notification-helper",
    when=push_notification_helper_default,
    help="Disable building the push notification helper",
)


@depends("--enable-push-notification-helper", when=push_notification_helper_default)
def push_notification_helper_flag(enabled):
    if enabled:
        return True


set_config("MOZ_PUSH_NOTIFICATION_HELPER", push_notification_helper_flag)
