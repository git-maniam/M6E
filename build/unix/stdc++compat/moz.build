FORCE_STATIC_LIB = True

NO_PGO = True

DisableStlWrapping()
COMPILE_FLAGS["CLANG_PLUGIN"] = []

OS_LIBS += ["-Wl,--version-script,%s/hide_std.ld" % SRCDIR]
