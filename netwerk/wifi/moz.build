XPIDL_SOURCES += [
    "nsIWifiAccessPoint.idl",
    "nsIWifiListener.idl",
    "nsIWifiMonitor.idl",
]

XPIDL_MODULE = "necko_wifi"

# for socket
OS_LIBS += CONFIG["SOCKET_LIBS"]

UNIFIED_SOURCES += [
    "nsWifiAccessPoint.cpp",
    "nsWifiMonitor.cpp",
]

SOURCES += [
    "mac/MacWifiScanner.mm",
]
LOCAL_INCLUDES += [
    "mac",
]

TEST_DIRS += ["gtest"]

FINAL_LIBRARY = "xul"

include("/ipc/chromium/chromium-config.mozbuild")

LICENSED_UNDER += ["gears-istumbler"]
LICENSED_UNDER["gears-istumbler"].paths = [
    "mac/Wifi.h",
]

SOURCE_HEADERS += [
    "nsWifiAccessPoint.h",
    "nsWifiMonitor.h",
    "WifiScanner.h",
]
