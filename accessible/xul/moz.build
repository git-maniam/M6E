]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

SOURCE_HEADERS += [
    "XULAlertAccessible.h",
    "XULComboboxAccessible.h",
    "XULElementAccessibles.h",
    "XULFormControlAccessible.h",
    "XULListboxAccessible.h",
