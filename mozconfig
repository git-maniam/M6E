ac_add_options --enable-application=browser
ac_add_options --target=aarch64-apple-darwin
ac_add_options --enable-optimize
ac_add_options --disable-debug
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-m6e
ac_add_options --disable-bootstrap
ac_add_options --with-wasi-sysroot=/opt/homebrew/share/wasi-sysroot
export WASM_CC=/opt/homebrew/opt/llvm/bin/clang
export WASM_CXX=/opt/homebrew/opt/llvm/bin/clang++
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --with-branding=browser/branding/m6e
ac_add_options --with-distribution-id=org.m6e
export MOZ_APP_BASENAME=M6E
export CC=/opt/homebrew/opt/llvm/bin/clang
M6E_SDK=$(xcrun --sdk macosx --show-sdk-path)
export CXX="/opt/homebrew/opt/llvm/bin/clang++ -nostdinc++ -isystem $M6E_SDK/usr/include/c++/v1"
export MOZ_LD64_KNOWN_GOOD=1
ac_add_options --enable-lto=cross
