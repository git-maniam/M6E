GeckoProgram("pingsender", linkage=None)
UNIFIED_SOURCES += [
    "pingsender.cpp",
]
SOURCE_HEADERS += [
    "pingsender.h",
]
USE_LIBS += [
    "zlib",
]

UNIFIED_SOURCES += [
    "pingsender_unix_common.cpp",
]


# Don't use the STL wrappers; we don't link with -lmozalloc, and it really
# doesn't matter here anyway.
DisableStlWrapping()
