with Files("**"):
    BUG_COMPONENT = ("Toolkit", "Startup and Profile System")

SOURCES += [
    "nsRemoteService.cpp",
]

SOURCE_HEADERS += [
    "nsRemoteClient.h",
    "nsRemoteServer.h",
    "nsRemoteService.h",
]

BROWSER_CHROME_MANIFESTS += ["tests/browser/browser.toml"]

XPCOM_MANIFESTS += [
    "components.conf",
]

XPIDL_SOURCES += [
    "nsIRemoteService.idl",
]

XPIDL_MODULE = "toolkitremote"


SOURCES += [
    "nsMacRemoteClient.mm",
    "nsMacRemoteServer.mm",
]
SOURCE_HEADERS += [
    "nsMacRemoteClient.h",
    "nsMacRemoteServer.h",
]

LOCAL_INCLUDES += [
    "../../profile",
    "../../xre",
]
FINAL_LIBRARY = "xul"
