LOCAL_INCLUDES = [
    "/toolkit/crashreporter",
]

USE_LIBS += [
    "breakpad_wrapper",
    "crash_helper_server",
]

OS_LIBS += [
    "-framework Foundation",
]
UNIFIED_SOURCES += [
    "crashhelper.cpp",
]
GeckoProgram("crashhelper", linkage=None)
