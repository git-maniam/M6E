# M6E: the BitTorrent feature (Phase 8, D33 to D37). Each test directory
# belongs to one step so parallel work does not touch the same manifest.

XPCSHELL_TESTS_MANIFESTS += [
    "tests/xpcshell/risk/xpcshell.toml",
    "tests/xpcshell/service/xpcshell.toml",
]

BROWSER_CHROME_MANIFESTS += [
    "tests/browser/open/browser.toml",
    "tests/browser/ui/browser.toml",
]

MOZ_SRC_FILES += [
    "m6e-torrent-rules.json",
    "M6ETorrentHandler.sys.mjs",
    "M6ETorrentRisk.sys.mjs",
    "M6ETorrentService.sys.mjs",
]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")
