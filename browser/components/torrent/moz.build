# M6E: the BitTorrent feature (Phase 8, D33 to D37).
# The test manifests under tests/ are registered here when they list a test:
# the build rejects an empty manifest. Planned: xpcshell "tests/xpcshell/risk"
# and "tests/xpcshell/service", browser chrome "tests/browser/open" and
# "tests/browser/ui" (one per step, so parallel work does not share one).

MOZ_SRC_FILES += [
    "M6ETorrentHandler.sys.mjs",
    "M6ETorrentRisk.sys.mjs",
    "M6ETorrentService.sys.mjs",
]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")
