# For BinaryPath::GetLong for Windows
LOCAL_INCLUDES += ["/xpcom/build"]

BROWSER_CHROME_MANIFESTS += ["test/browser.toml"]
XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]
TEST_DIRS += [
    "test/gtest",
]

JAR_MANIFESTS += ["jar.mn"]

XPIDL_SOURCES += [
    "nsIShellService.idl",
]

SOURCES += [
    "nsShellService.cpp",
]

SOURCE_HEADERS += [
    "nsShellService.h",
]

XPIDL_SOURCES += [
    "nsIMacShellService.idl",
]
SOURCES += [
    "nsMacShellService.mm",
]
SOURCE_HEADERS += [
    "nsMacShellService.h",
]
LOCAL_INCLUDES += [
    # For CocoaFileUtils
    "/xpcom/io"
]
# UniformTypeIdentifiers only exists on macOS 11+; weak-link it so builds
# targeting older macOS still load (its use is guarded by @available).
OS_LIBS += [
    "-weak_framework UniformTypeIdentifiers",
]

XPIDL_MODULE = "shellservice"

if SOURCES:
    FINAL_LIBRARY = "browsercomps"

MOZ_SRC_FILES += [
    "HeadlessShell.sys.mjs",
    "ScreenshotChild.sys.mjs",
    "ShellService.sys.mjs",
    "WindowsSetDefaultRedirect.sys.mjs",
]

MOZ_SRC_FILES += [
    "StartupOSIntegration.sys.mjs",
]

for var in (
    "MOZ_APP_DISPLAYNAME",
    "MOZ_APP_NAME",
    "MOZ_APP_VERSION",
    "MOZ_DEFAULT_BROWSER_AGENT",
):
    DEFINES[var] = '"%s"' % CONFIG[var]




with Files("docs/**"):
    SCHEDULES.exclusive = ["docs"]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "Shell Integration")
