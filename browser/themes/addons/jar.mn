browser.jar:
%  resource builtin-themes %content/builtin-themes/

  content/builtin-themes/aiwindow/manifest.json        (aiwindow/manifest.json)
  content/builtin-themes/aiwindow/aiwindow-theme.css   (aiwindow/aiwindow-theme.css)

  content/builtin-themes/aiwindow-nova/manifest.json   (aiwindow-nova/manifest.json)
  content/builtin-themes/aiwindow-nova/aiwindow-theme-nova.css  (aiwindow-nova/aiwindow-theme-nova.css)

  content/builtin-themes/privatewindow/manifest.json            (privatewindow/manifest.json)
