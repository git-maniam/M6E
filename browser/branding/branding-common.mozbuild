@template
def FirefoxBranding():
    if CONFIG["MOZ_BRANDING_DIRECTORY"] == "browser/branding/official":
        JS_PREFERENCE_PP_FILES += [
            "pref/firefox-branding.js",
        ]
    else:
        JS_PREFERENCE_FILES += [
            "pref/firefox-branding.js",
        ]

