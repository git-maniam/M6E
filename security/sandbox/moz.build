BROWSER_CHROME_MANIFESTS += [
    "test/browser.toml",
    "test/browser_bug1717599_XDG-CONFIG-DIRS.toml",
    "test/browser_bug1717599_XDG-CONFIG-HOME.toml",
    "test/browser_profiler.toml",
    "test/browser_snap.toml",
    "test/browser_xdg_default.toml",
    "test/browser_xdg_mozLegacyHome.toml",
    "test/browser_xdg_xdgConfigHome.toml",
]

with Files("**"):
    BUG_COMPONENT = ("Core", "Security: Process Sandboxing")

DIRS += ["common"]

DIRS += ["mac"]

LICENSED_UNDER += ["chromium"]
# The Chromium-licensed copies outside chromium/: the rest of
# chromium-shim/ is Mozilla-written stubs for files Chromium generates, and in
# glibc_hack/ only the vendored namespace_sandbox.cc and the excerpt
# extract-sandbox.py cuts out of it -- the copy SandboxLaunch.cpp compiles --
# are Chromium's; the script itself is ours.
LICENSED_UNDER["chromium"].paths = [
    "chromium",
    "chromium-shim/base/check_version_internal.h",
    "chromium-shim/base/debug/stack_trace.cpp",
    "chromium-shim/sandbox/win/src/registry_*",
]

LICENSES += ["cityhash"]
LICENSES["cityhash"].title = "CityHash License"
LICENSES["cityhash"].text = "LICENSE-NOTICE-cityhash.txt"
LICENSES["cityhash"].spdx = "MIT"
LICENSES["cityhash"].subcomponent = True

LICENSED_UNDER += ["cityhash"]
LICENSED_UNDER["cityhash"].paths = [
    "chromium/base/third_party/cityhash",
]

LICENSED_UNDER += ["superfasthash"]
LICENSED_UNDER["superfasthash"].paths = [
    "chromium/base/third_party/superfasthash",
]

LICENSED_UNDER += ["unicode"]
LICENSED_UNDER["unicode"].paths = [
    "chromium/base/third_party/icu",
]
