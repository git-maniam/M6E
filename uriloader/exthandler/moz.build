SPHINX_TREES["/uriloader/exthandler"] = "docs"

with Files("**"):
    BUG_COMPONENT = ("Firefox", "File Handling")

TEST_DIRS += ["tests"]

XPIDL_SOURCES += [
    "nsCExternalHandlerService.idl",
    "nsIContentDispatchChooser.idl",
    "nsIExternalHelperAppService.idl",
    "nsIExternalProtocolService.idl",
    "nsIHandlerService.idl",
    "nsIHelperAppLauncherDialog.idl",
    "nsISharingHandlerApp.idl",
]

XPIDL_MODULE = "exthandler"

osdir = "mac"

EXPORTS += [osdir + "/nsOSHelperAppService.h"]

EXPORTS += [
    "ContentHandlerService.h",
    "nsExternalHelperAppService.h",
    "nsMIMEInfoChild.h",
    "nsOSHelperAppServiceChild.h",
]

EXPORTS += [
    "nsLocalHandlerApp.h",
]

EXPORTS.mozilla.dom += [
    "ExternalHelperAppChild.h",
    "ExternalHelperAppParent.h",
]

UNIFIED_SOURCES += [
    "ContentHandlerService.cpp",
    "ExternalHelperAppChild.cpp",
    "ExternalHelperAppParent.cpp",
    "HandlerServiceParent.cpp",
    "nsExternalHelperAppService.cpp",
    "nsExternalProtocolHandler.cpp",
    "nsLocalHandlerApp.cpp",
    "nsMIMEInfoImpl.cpp",
    "nsOSHelperAppServiceChild.cpp",
]

if CONFIG["MOZ_BUILD_APP"] == "browser":
    DEFINES["MOZ_BUILD_APP_IS_BROWSER"] = True

UNIFIED_SOURCES += [
    "mac/nsLocalHandlerAppMac.mm",
    "mac/nsMIMEInfoMac.mm",
    "mac/nsOSHelperAppService.mm",
]


EXTRA_JS_MODULES += [
    "ExtHandlerService.sys.mjs",
    "WebHandlerApp.sys.mjs",
]

EXTRA_JS_MODULES.handlers += [
    "HandlerList.sys.mjs",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

IPDL_SOURCES += [
    "PExternalHelperApp.ipdl",
    "PHandlerService.ipdl",
]

SOURCE_HEADERS += [
    "HandlerServiceChild.h",
    "HandlerServiceParent.h",
    "nsExternalProtocolHandler.h",
    "nsMIMEInfoImpl.h",
]

include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"

LOCAL_INCLUDES += [
    "/docshell/base",
    "/dom/base",
    "/dom/ipc",
    "/netwerk/base",
    "/netwerk/protocol/http",
]



with Files("unix/**"):
    SCHEDULES.exclusive = ["linux"]

with Files("win/**"):
    SCHEDULES.exclusive = ["windows"]

with Files("mac/**"):
    SCHEDULES.exclusive = ["macosx"]

with Files("android/**"):
    SCHEDULES.exclusive = ["android"]
